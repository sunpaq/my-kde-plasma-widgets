[Desktop Entry]
Type=Application
Name=Cover-aware Switcher (Fcitx 5 / Plasma Keyboard)
Comment=Uses Fcitx 5 when the Type Cover is attached, Plasma Keyboard otherwise
Exec=@HOMEBIN@/kwin-im-switcher
Icon=input-keyboard-virtual
NoDisplay=true
Terminal=false
Categories=System;Utility;
StartupNotify=false
X-KDE-Wayland-VirtualKeyboard=true
X-KDE-Wayland-Interfaces=org_kde_plasma_window_management